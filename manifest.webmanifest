{
 "name": "Wealthlens",
 "short_name": "Wealthlens",
 "lang": "de",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "background_color": "#050a14",
 "theme_color": "#050a14",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any maskable"
  }
 ],
 "share_target": {
  "action": "./teilen",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "files": [
    {
     "name": "dateien",
     "accept": [
      "text/csv",
      ".csv",
      "text/comma-separated-values",
      "text/plain",
      "application/vnd.ms-excel",
      "application/octet-stream"
     ]
    }
   ]
  }
 },
 "file_handlers": [
  {
   "action": "./",
   "accept": {
    "text/csv": [
     ".csv"
    ]
   }
  }
 ],
 "launch_handler": {
  "client_mode": "focus-existing"
 }
}